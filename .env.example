# ── REQUIRED ────────────────────────────────────────────────────────────

# Signed cookie secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-in-production

# ── OPTIONAL: server config ─────────────────────────────────────────────
PORT=3000
DB_PATH=./data/handy.db
NODE_ENV=production

# ── OPTIONAL: outbound SMS (SignalWire / Twilio-compatible) ─────────────
# If unset, all SMS features silently no-op. The app still runs.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE=
SIGNALWIRE_FROM_NUMBER=

# Owner cell for operator SMS notifications (new lead alerts, ticket pings)
OPERATOR_CELL=

# ── OPTIONAL: PayPal invoicing ──────────────────────────────────────────
# If unset, invoice-send falls back to plain email with payment instructions
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live

# ── OPTIONAL: Google Maps (address geocoding, distance checks) ──────────
# Falls back to non-geocoded flow if unset
GOOGLE_MAPS_KEY=

# ── OPTIONAL: Local LLM for the "Noble AI Chat" tab in the owner dashboard
# Points at an Ollama-compatible endpoint. Chat tab hidden if unset.
OLLAMA_URL=
OLLAMA_MODEL=
